{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["spike/**/*.ts", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "web/**/*.ts", "web/**/*.tsx"]
}
