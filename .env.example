# Optional platform: configure the complete GitHub group, or leave the group empty for GitLab-only.
PATCHPAW_GITHUB_APP_ID=
# URL-safe slug chosen when creating the GitHub App.
PATCHPAW_GITHUB_APP_SLUG=
# Secret configured in the GitHub App webhook settings.
PATCHPAW_GITHUB_WEBHOOK_SECRET=
# PEM file path, relative to the project root or absolute for a service deployment.
# Forward slashes are accepted by Node.js on all supported platforms.
PATCHPAW_GITHUB_PRIVATE_KEY_PATH=
# Required: the public origin served to the browser, with scheme and host but no path.
# Use HTTPS for a deployed instance. GitHub uses /github/webhook; GitLab uses /gitlab/webhook/<connection-id>.
PATCHPAW_PUBLIC_ORIGIN=https://patchpaw.example.com
# Required: local listener port. Put TLS termination in a reverse proxy for production.
PATCHPAW_PORT=3000
# Repository used by the passive GitHub pull-request event path (owner/repository).
PATCHPAW_GITHUB_TEST_REPO=
# Optional: GitHub login to notify alongside a pull-request author.
PATCHPAW_OPERATOR_GITHUB_LOGIN=
# Required for this web setup: create with `npm run generate:admin-token`.
# Do not leave this variable empty: configuration validation rejects an empty token.
# Keep this value only in the server-side .env; never commit it or put it in Vite variables.
PATCHPAW_ADMIN_TOKEN=
# Optional: durable runtime home. Empty uses ~/.patchpaw on supported Linux/macOS hosts.
PATCHPAW_HOME=
# Optional migration-only source for importing a legacy runtime home.
PATCHPAW_LEGACY_HOME=

# Optional GitLab connections. Use *_env references to keep secret values out of this JSON value.
# Example: [{"id":"gitlab-prod","instance_url":"https://gitlab.example.com","project_ids":["42"],"token_env":"PATCHPAW_GITLAB_TOKEN","webhook_secret_env":"PATCHPAW_GITLAB_WEBHOOK_SECRET","webhook_mode":"secret","bot_login":"patchpaw"}]
PATCHPAW_GITLAB_CONNECTIONS=
PATCHPAW_GITLAB_TOKEN=
PATCHPAW_GITLAB_WEBHOOK_SECRET=

# Provider settings used when bootstrapping the initial control-plane provider.
# Leave credentials empty in this template and provide them through your private .env or the admin UI.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=
# Optional for thinking-capable models: low, high, or max.
ZAI_REASONING_EFFORT=
