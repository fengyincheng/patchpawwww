{
  "name": "patchpaw",
  "version": "0.0.0",
  "description": "Self-hosted GitHub App and GitLab integration for repository review, repair, CI and conversation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fengyincheng/patchpawwww.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "run-pr": "node --import tsx scripts/run-pr.ts",
    "recover-run": "node --import tsx scripts/recover-run.ts",
    "migrate-runtime": "node --import tsx scripts/migrate-runtime.ts",
    "backup-runtime": "node --import tsx scripts/backup-runtime.ts",
    "restore-runtime": "node --import tsx scripts/restore-runtime.ts",
    "bootstrap:control-plane": "node --import tsx scripts/bootstrap-control-plane.ts",
    "migrate:builtin-assets": "node --import tsx scripts/migrate-builtin-assets.ts",
    "sync:operation": "node --import tsx scripts/sync-operation-prompts.ts",
    "generate:admin-token": "node --import tsx scripts/generate-admin-token.ts",
    "agent:open": "node --import tsx scripts/agent-open.ts",
    "agent:status": "node --import tsx scripts/agent-status.ts",
    "agent:runs": "node --import tsx scripts/agent-runs.ts",
    "start": "node --import tsx src/index.ts",
    "check": "tsc --noEmit",
    "build": "vite build --config web/vite.config.ts",
    "verify:frontend": "node --import tsx scripts/verify-frontend.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:serial": "node --import tsx scripts/run-test-files.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.44",
    "@libsql/client": "0.17.4",
    "@mastra/core": "1.64.0",
    "@mastra/libsql": "1.22.3",
    "@mastra/memory": "1.28.2",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@openai/agents": "0.17.0",
    "fastify": "5.12.3",
    "openai": "7.10.0",
    "zod": "4.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "node": "22.23.2",
    "typescript": "7.0.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.3.6"
  }
}
